---
import { Wifi, ShieldAlert, KeyRound, CheckCircle2 } from 'lucide-react';
---

<section id="wireless" class="py-20 lg:py-28 relative">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Visual Mockup (Wireless bridge) -->
      <div class="lg:col-span-6 flex justify-center order-last lg:order-first reveal">
        <div class="relative w-full max-w-md h-72 rounded-2xl border border-border-custom bg-bg-secondary/20 flex items-center justify-between px-8 sm:px-12 overflow-hidden">
          
          <!-- background grids -->
          <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(212,175,55,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(212,175,55,0.02)_1px,transparent_1px)] bg-[size:16px_16px] z-0"></div>

          <!-- PC card mockup -->
          <div class="z-10 flex flex-col items-center justify-center p-3 rounded-xl border border-border-custom bg-bg-secondary w-28 h-28 shadow-sm">
            <svg class="h-8 w-8 text-text-muted mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="font-display text-[10px] font-bold text-text-main">Windows PC</span>
          </div>

          <!-- Connecting wireless particles line -->
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-1/3 flex items-center justify-center">
            <div class="relative w-full h-[2px] bg-border-custom">
              <!-- Wireless Signal Icons along line -->
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 flex h-6 w-6 items-center justify-center rounded-full bg-gold/10 border border-gold/30 text-gold animate-pulse">
                <Wifi class="h-3 w-3" />
              </div>
              <div class="absolute left-0 top-1/2 -translate-y-1/2 h-1.5 w-1.5 rounded-full bg-gold animate-ping"></div>
              <div class="absolute right-0 top-1/2 -translate-y-1/2 h-1.5 w-1.5 rounded-full bg-gold animate-ping" style="animation-delay: 0.5s"></div>
            </div>
          </div>

          <!-- Phone card mockup -->
          <div class="z-10 flex flex-col items-center justify-center p-3 rounded-xl border border-gold bg-bg-secondary w-28 h-28 shadow-md shadow-gold-glow">
            <svg class="h-8 w-8 text-gold mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <span class="font-display text-[10px] font-bold text-gold">Redmi Note 7 Pro</span>
          </div>

        </div>
      </div>

      <!-- Right Column: Step Copy -->
      <div class="lg:col-span-6 flex flex-col items-center lg:items-start text-center lg:text-left reveal">
        <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-text-main mb-6">
          Cable-Free Syncing. <br class="hidden sm:inline" />
          <span class="text-gold">No Hotspots Required.</span>
        </h2>
        
        <p class="font-body text-sm sm:text-base text-text-muted mb-8 leading-relaxed max-w-xl">
          Connect over your local Wi-Fi router. Warp Transfer handles standard Android 11+ Developer Pairing handshakes natively, meaning you only need a cable once during first-time setup.
        </p>

        <!-- Step List -->
        <div class="space-y-4 w-full max-w-lg">
          
          <div class="flex items-start space-x-3 text-left">
            <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-gold-glow border border-gold/30 text-gold mt-0.5">
              <span class="text-[10px] font-bold font-body">1</span>
            </div>
            <div>
              <h4 class="font-display text-sm font-bold text-text-main">Enable Debugging</h4>
              <p class="font-body text-xs text-text-muted mt-0.5">Toggle USB Debugging and Wireless Debugging on your phone.</p>
            </div>
          </div>

          <div class="flex items-start space-x-3 text-left">
            <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-gold-glow border border-gold/30 text-gold mt-0.5">
              <span class="text-[10px] font-bold font-body">2</span>
            </div>
            <div>
              <h4 class="font-display text-sm font-bold text-text-main">Open Pairing Dialog</h4>
              <p class="font-body text-xs text-text-muted mt-0.5">Click "Connect Wirelessly" in Warp settings to show pairing prompts.</p>
            </div>
          </div>

          <div class="flex items-start space-x-3 text-left">
            <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-gold-glow border border-gold/30 text-gold mt-0.5">
              <span class="text-[10px] font-bold font-body">3</span>
            </div>
            <div>
              <h4 class="font-display text-sm font-bold text-text-main">Enter Credentials</h4>
              <p class="font-body text-xs text-text-muted mt-0.5">Input the IP/Port and 6-digit Pairing Code displayed on your phone.</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
